# Polymarket Weather Bot Configuration

# Execution Mode: 0 for Paper Trading (safe default), 1 for Live Trading
LIVE=0

# Brier Gate Override: 0 requires T6 gate passage (>=50 trades, >=14 days, model Brier < market Brier)
# Set to 1 ONLY if explicitly intending to bypass gate.
FORCE_LIVE=0

# Polymarket CLOB Credentials (Only required if LIVE=1)
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Risk Management
MAX_BANKROLL=1000.0
MIN_EDGE_AFTER_FEE=0.04

# Supabase Real-Time Telemetry & Sync
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
